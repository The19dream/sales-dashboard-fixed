# ==============================================================================
# FODS Enterprise Decision Support Dashboard - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase PostgreSQL Connection
# ------------------------------------------------------------------------------
# Option A: Full Connection String URI (Recommended)
# Find this in Supabase Project Settings -> Database -> Connection string -> URI
# Use Transaction Pooler (port 6543) or Direct connection (port 5432).
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require"

# Option B: Discrete credentials (alternative)
# SUPABASE_DB_HOST="db.[YOUR-PROJECT-REF].supabase.co"
# SUPABASE_DB_PORT=5432
# SUPABASE_DB_NAME="postgres"
# SUPABASE_DB_USER="postgres"
# SUPABASE_DB_PASSWORD="your_password"
# SUPABASE_DB_SSLMODE="require"

# ------------------------------------------------------------------------------
# 2. FastAPI Backend Service
# ------------------------------------------------------------------------------
FASTAPI_PORT=8001

# ------------------------------------------------------------------------------
# 3. Gemini AI Insights (Optional)
# ------------------------------------------------------------------------------
# AI Studio automatically injects this from user secrets if configured.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Injected automatically by AI Studio runtime
APP_URL="MY_APP_URL"
